---
import siteConfig from '@/config/site.config';
import { content } from '@/config/content';
import ContactForm from '@/components/ui/forms/ContactForm.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import FixtureInventedBadge from '@/components/ui/FixtureInventedBadge.astro';
import { locales } from '@/config/site.config';
---

<section id="contact" data-review-id="contact-section" class="py-16 md:py-24">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <h2 class="font-display text-3xl text-foreground md:text-5xl">
          {locales.map((locale) => (
            <span data-lang={locale}>
              {content.contact[locale].title}{' '}
              <span class="text-accent italic">{content.contact[locale].accentWord}</span>
            </span>
          ))}
        </h2>
        <p class="mt-4 text-lg text-foreground-muted">
          {locales.map((locale) => (
            <span data-lang={locale}>{content.contact[locale].subtitle}</span>
          ))}
        </p>

        <div class="mt-10 space-y-4 border-t border-border pt-8">
          <a href={`mailto:${siteConfig.email}`} data-review-target="contact-email" class="block text-base text-foreground transition-colors hover:text-accent">
            {siteConfig.email}
          </a>
          {siteConfig.phone && (
            <div class="flex flex-wrap items-center gap-2">
              <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} data-review-target="contact-phone" class="block text-base text-foreground transition-colors hover:text-accent">
                {siteConfig.phone}
              </a>
              <FixtureInventedBadge fieldKey="profile.phone" />
            </div>
          )}
          <p class="text-sm text-foreground-muted">
            {locales.map((locale) => (
              <span data-lang={locale}>{content.contact[locale].location}</span>
            ))}
          </p>
          <div data-review-target="contact-socials">
            <SocialLinks linkClass="transition-colors hover:text-accent" />
          </div>
        </div>
      </div>

      <ContactForm />
    </div>
  </div>
</section>
